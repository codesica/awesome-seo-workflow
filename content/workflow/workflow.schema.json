{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "First Crawl bilingual workflow content",
  "type": "object",
  "required": [
    "schemaVersion",
    "home",
    "stages",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "contentId",
          "order",
          "status",
          "sourceIds",
          "title",
          "summary",
          "goal",
          "nextStep",
          "entryRequirement",
          "prerequisites",
          "inputs",
          "tools",
          "deliverables",
          "acceptance",
          "stopConditions",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "contentId": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "status": {
            "const": "editorially-reviewed-not-site-tested"
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "title": {
            "$ref": "#/$defs/localized"
          },
          "summary": {
            "$ref": "#/$defs/localized"
          },
          "goal": {
            "$ref": "#/$defs/localized"
          },
          "nextStep": {
            "$ref": "#/$defs/localized"
          },
          "entryRequirement": {
            "$ref": "#/$defs/localized"
          },
          "prerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/localized"
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/localized"
            }
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/localized"
            }
          },
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/localized"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/localized"
            }
          },
          "stopConditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/localized"
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "instruction",
                "output"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "$ref": "#/$defs/localized"
                },
                "instruction": {
                  "$ref": "#/$defs/localized"
                },
                "output": {
                  "$ref": "#/$defs/localized"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": [
        "zh-CN",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
