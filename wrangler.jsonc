{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "lab-seo-starter-skills",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    {
      "pattern": "skills.yangluotong.top",
      "custom_domain": true
    }
  ]
}
