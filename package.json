{
  "name": "awesome-seo-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open beginner field guide to making a small website findable.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "deploy": "npm run build:release && npx wrangler@4.149.0 deploy",
    "check": "python3 scripts/check-project.py",
    "check:standards": "python3 scripts/validate-standards.py"
  },
  "devDependencies": {
    "markdown-it": "15.0.2"
  }
}
